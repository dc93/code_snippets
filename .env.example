# Media Automation System - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# JDOWNLOADER CONFIGURATION (REQUIRED)
# ============================================
# Get these from your My.JDownloader account
# https://my.jdownloader.org/
JDOWNLOADER_EMAIL=your-email@example.com
JDOWNLOADER_PASSWORD=your-jdownloader-password
JDOWNLOADER_DEVICE_NAME=your-device-name
JDOWNLOADER_APP_KEY=MediaAutomation

# ============================================
# PATHS (REQUIRED)
# ============================================
# Where JDownloader saves downloaded files
DOWNLOAD_FOLDER=/downloads

# Where to organize the TV series library
TV_LIBRARY_PATH=/media/tv

# Temporary processing folder
PROCESSING_FOLDER=/downloads/processing

# ============================================
# QUALITY PREFERENCES
# ============================================
# Preferred video quality (2160p, 1080p, 720p, 480p)
PREFERRED_QUALITY=1080p

# Download subtitled versions
DOWNLOAD_SUBTITLED=True

# Language preference (ITA, ENG, MULTI)
LANGUAGE_PREFERENCE=ITA

# ============================================
# MONITORING SETTINGS
# ============================================
# How often to check for new episodes (in minutes)
CHECK_INTERVAL_MINUTES=30

# How often to check RSS feeds (in minutes)
RSS_CHECK_INTERVAL_MINUTES=15

# Maximum episodes to process per check
MAX_EPISODES_PER_CHECK=50

# ============================================
# FILE ORGANIZATION
# ============================================
# Automatically organize downloaded files
AUTO_ORGANIZE=True

# Delete original files after organizing
DELETE_AFTER_ORGANIZE=True

# Minimum file size to consider valid (in MB)
MINIMUM_FILE_SIZE_MB=50

# Library folder structure
# Supported formats: {show}, {season}, {season_number}, {episode}, {episode_number}, {title}, {quality}
LIBRARY_STRUCTURE={show}/{season}/{episode}

# ============================================
# WEB DASHBOARD
# ============================================
# Dashboard port
DASHBOARD_PORT=5001

# Dashboard host (0.0.0.0 for network access, 127.0.0.1 for local only)
DASHBOARD_HOST=0.0.0.0

# Enable debug mode (set to False for production)
DASHBOARD_DEBUG=False

# ============================================
# NOTIFICATIONS (OPTIONAL)
# ============================================
# Enable notifications
ENABLE_NOTIFICATIONS=True

# Notification methods (comma-separated: email,webhook)
NOTIFICATION_METHODS=email

# Email settings
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=media@automation.local
EMAIL_TO=you@example.com

# Webhook URLs (comma-separated for Discord, Slack, etc.)
WEBHOOK_URLS=

# ============================================
# ADVANCED SETTINGS
# ============================================
# Maximum concurrent downloads
MAX_CONCURRENT_DOWNLOADS=3

# Retry failed downloads
RETRY_FAILED_DOWNLOADS=True

# Maximum retry attempts
MAX_RETRY_ATTEMPTS=3

# Enable backlog search
BACKLOG_SEARCH_ENABLED=True

# How many days back to search for missing episodes
BACKLOG_DAYS=7

# Logging level (DEBUG, INFO, WARNING, ERROR)
AUTOMATION_LOG_LEVEL=INFO

# ============================================
# SCRAPER SETTINGS
# ============================================
# Use Selenium for scraping (recommended for bot protection)
USE_SELENIUM=True

# Run Selenium in headless mode
SELENIUM_HEADLESS=True

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Random delay between requests (min and max in seconds)
REQUEST_DELAY_MIN=2
REQUEST_DELAY_MAX=5

# ============================================
# DATABASE PATHS (OPTIONAL)
# ============================================
# Media database path (leave empty for default: instance/media_database.db)
# MEDIA_DB_PATH=/path/to/media_database.db

# Automation database path (leave empty for default: instance/media_automation.db)
# AUTOMATION_DB_PATH=/path/to/media_automation.db
